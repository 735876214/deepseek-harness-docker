# DeepSeek Harness Docker 配置示例
# 复制为 .env 后修改：cp config/dsh.env.example .env
# docker compose 会自动读取 .env

# 镜像标签：latest 或具体上游版本，例如 0.2.2-alpha.3
# 也可用 upstream-<commit7> 精确锁定某次上游提交
IMAGE_TAG=latest

# dsh 运行配置
DSH_PROFILE=web
# 留空 = 自动绑定本容器 IP（dsh web 拒绝 0.0.0.0，必须绑定具体接口 IP）。
# 仅在多网卡需指定某接口 IP 时才填具体 IPv4/IPv6。
DSH_HOST=
DSH_PORT=3080
DSH_HOME=/data
# 透传额外 dsh 参数，例如切换模板：--from-default-profile web
DSH_EXTRA_ARGS=

# 时区与代理（如NAS走代理访问模型API）
TZ=Asia/Shanghai
HTTP_PROXY=
HTTPS_PROXY=
