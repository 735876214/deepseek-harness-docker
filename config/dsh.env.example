# DeepSeek Harness Docker 配置示例
# 复制为 .env 后修改：cp config/dsh.env.example .env
# docker compose 会自动读取 .env

# 镜像标签：latest 或具体上游版本，例如 0.2.2-alpha.3
# 也可用 upstream-<commit7> 精确锁定某次上游提交
IMAGE_TAG=latest

# ---- 鉴权网关（对外端口）----
DSH_PORT=3080
# dsh web 实际运行的内部端口（仅回环，网关以 --trusted-host 免 token 转发）
DSH_DSH_PORT=3081

# 登录页访问口令：留空 = 容器启动随机生成并打印到日志（docker logs 查看）
DSH_LOGIN_PASSWORD=
# 会话签名密钥：留空 = 每次启动随机（重启后需重新登录）；固定后重启仍有效
DSH_SESSION_SECRET=
# 在 TLS 反向代理之后运行时设为 1，给登录 Cookie 加 Secure 标记
DSH_SECURE_COOKIE=

# dsh 运行配置
DSH_PROFILE=web
DSH_HOME=/data
# 透传额外 dsh 参数，例如切换模板：--from-default-profile web
DSH_EXTRA_ARGS=

# 时区与代理（如NAS走代理访问模型API）
TZ=Asia/Shanghai
HTTP_PROXY=
HTTPS_PROXY=
